[Disk]
label=💾 
command=df -h | grep "/dev/" | head -1 | awk '{print $3 "/" $2}'
interval=3600
color=#cdb4db

[RAM]
label=📝 
command=free -h | awk '$1 == "Mem:" {print $3 "/" $2}'
interval=30
color=#1fffff

# Update time every 5 seconds
[time]
label=📆 
command=date '+%Y-%m-%d %H:%M'
interval=60
color=#e9c46a
